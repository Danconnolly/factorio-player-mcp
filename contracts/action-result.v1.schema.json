{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorio-player-mcp.dev/contracts/action-result.v1.schema.json",
  "title": "Factorio Player MCP Action Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "action_id",
    "action_type",
    "requested_tick",
    "resolved_tick",
    "outcome",
    "reason"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "action_id": {"type": "string", "minLength": 1},
    "action_type": {
      "enum": ["craft", "interact_inventory", "mine", "move", "place", "rotate", "wait"]
    },
    "requested_tick": {"type": "integer", "minimum": 0},
    "resolved_tick": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["accepted", "completed", "rejected", "cancelled", "failed"]},
    "reason": {"type": "string"},
    "inventory_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "count_delta"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "count_delta": {"type": "integer"}
        }
      }
    }
  }
}
